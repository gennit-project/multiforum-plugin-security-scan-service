# Copy to `.env` for local development. All vars are prefixed SCAN_.

# Shared secret the plugin must send as `X-API-Key`. Leave empty to disable
# auth locally (never do this in production).
SCAN_API_KEY=local-dev-key

# VirusTotal API key. Leave empty to skip the reputation check.
SCAN_VIRUSTOTAL_API_KEY=

# Optional overrides (defaults shown):
# SCAN_MAX_DOWNLOAD_BYTES=104857600
# SCAN_MAX_DECOMPRESSION_RATIO=100
# SCAN_MAX_ZIP_ENTRIES=10000
# SCAN_REQUIRE_README=false
# SCAN_REQUIRE_LICENSE=false
